# Unanchored: cargo creates target/ wherever it is invoked, so match the
# directory at any depth. Enumerating known locations one at a time is what
# let benchmark/target/ into history.
target/
/data/
/output/
/.playwright-mcp/
*.db
*.db-shm
*.db-wal
secrets.toml
GOAL.md
/tests/browser/artifacts/
/tests/browser/node_modules/
/tests/e2e/node_modules/
/tests/e2e/orm-compat/generated/
/node_modules/
/tests/load/node_modules/
/tests/memsoak/node_modules/
/tests/mtr/node_modules/
/tests/mtr/.cache/
/tests/mtr/diffs/
/benchmark/workloads/commerce-production-v1/results/diffs/
/tests/e2e/results-partial.json
/tests/e2e/results-partial.md
/validate-out/
REVIEW.md
/tests/corpus/bi-captured/raw/
/tests/corpus/bi-captured/*.raw.json
# Local dashboard-development data directory (docs/development.md).
.devdata/
.env

