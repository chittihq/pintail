{
  "name": "pintail-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "bun run generate:prisma && bun run run.ts",
    "generate:prisma": "prisma generate --schema orm-compat/prisma/schema.prisma",
    "test:orm": "bun run generate:prisma && bun test orm-compat && tsc --project orm-compat/tsconfig.json",
    "test:recovery": "bash recovery/check.sh"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "mysql2": "3.23.2",
    "prisma": "7.9.1",
    "sequelize": "6.37.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
